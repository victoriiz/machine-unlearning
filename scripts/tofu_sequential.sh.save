#!/bin/bash
#SBATCH --job-name=tofu_seq
#SBATCH --partition=secondary
#SBATCH --gres=gpu:H100:1
#SBATCH --mem=32G
#SBATCH --time=08:00:00
#SBATCH --output=/u/vz8/unlearning/logs/seq_%j.log
#SBATCH --error=/u/vz8/unlearning/logs/seq_%j.err

MODEL="Llama-3.2-1B-Instruct"
TRAINER="GradAscent"
EPOCHS=5
BATCH_SIZE=4
GRAD_ACCUM=4

PYTHON="/u/vz8/.conda/envs/tofu_env/bin/python"
BASE_DIR="/u/vz8/unlearning/open-unlearning"

export HF_HOME=/scratch/vz8/.cache/huggingface
export TOKENIZERS_PARALLELISM=false
export TRITON_CACHE_DIR=/scratch/vz8/.triton

cd $BASE_DIR
mkdir -p /u/vz8/unlearning/logs

echo "=============================="
echo "Python: $($PYTHON --version)"
echo "Starting sequential unlearning pipeline"
echo "=============================="


# ══════════════════════════════════════════════════════════════
# ROUND 0: Evaluate base model (before any unlearning)
# ══════════════════════════════════════════════════════════════
echo "--- Round 0: Evaluating base model ---"
BASE_MODEL="open-unlearning/tofu_${MODEL}_full"

$PYTHON src/eval.py --config-name=eval.yaml \
  experiment=eval/tofu/default \
  model=${MODEL} \
  model.model_args.pretrained_model_name_or_path=${BASE_MODEL} \
  retain_logs_path=saves/eval/tofu_${MODEL}_retain90/TOFU_EVAL.json \
  task_name=sequential_round0_base


# ══════════════════════════════════════════════════════════════
# ROUND 1: Unlearn forget01 from base model
# ══════════════════════════════════════════════════════════════
echo "--- Round 1: Unlearning forget01 ---"

$PYTHON src/train.py --config-name=unlearn.yaml \
  experiment=unlearn/tofu/default \
  forget_split=forget01 \
  retain_split=retain99 \
  trainer=${TRAINER} \
  model=${MODEL} \
  model.model_args.pretrained_model_name_or_path=${BASE_MODEL} \
  task_name=sequential_round1 \
  trainer.args.num_train_epochs=${EPOCHS} \
  trainer.args.per_device_train_batch_size=${BATCH_SIZE} \
  trainer.args.gradient_accumulation_steps=${GRAD_ACCUM} \
  +trainer.args.save_strategy=epoch \
  trainer.args.output_dir=saves/models/sequential_round1

echo "--- Round 1: Evaluating ---"
$PYTHON src/eval.py --config-name=eval.yaml \
  experiment=eval/tofu/default \
  model=${MODEL} \
  model.model_args.pretrained_model_name_or_path=saves/models/sequential_round1 \
  retain_logs_path=saves/eval/tofu_${MODEL}_retain90/TOFU_EVAL.json \
  task_name=sequential_round1_eval


# ══════════════════════════════════════════════════════════════
# ROUND 2: Unlearn forget05 starting from round1 model
# ══════════════════════════════════════════════════════════════
echo "--- Round 2: Unlearning forget05 from round1 model ---"

$PYTHON src/train.py --config-name=unlearn.yaml \
  experiment=unlearn/tofu/default \
  forget_split=forget05 \
  retain_split=retain95 \
  trainer=${TRAINER} \
  model=${MODEL} \
  model.model_args.pretrained_model_name_or_path=saves/models/sequential_round1 \
  task_name=sequential_round2 \
  trainer.args.num_train_epochs=${EPOCHS} \
  trainer.args.per_device_train_batch_size=${BATCH_SIZE} \
  trainer.args.gradient_accumulation_steps=${GRAD_ACCUM} \
  +trainer.args.save_strategy=epoch \
  trainer.args.output_dir=saves/models/sequential_round2

echo "--- Round 2: Evaluating ---"
$PYTHON src/eval.py --config-name=eval.yaml \
  experiment=eval/tofu/default \
  model=${MODEL} \
  model.model_args.pretrained_model_name_or_path=saves/models/sequential_round2 \
  retain_logs_path=saves/eval/tofu_${MODEL}_retain90/TOFU_EVAL.json \
  task_name=sequential_round2_eval


# ══════════════════════════════════════════════════════════════
# ROUND 3: Unlearn forget10 starting from round2 model
# ══════════════════════════════════════════════════════════════
echo "--- Round 3: Unlearning forget10 from round2 model ---"

$PYTHON src/train.py --config-name=unlearn.yaml \
  experiment=unlearn/tofu/default \
  forget_split=forget10 \
  retain_split=retain90 \
  trainer=${TRAINER} \
  model=${MODEL} \
  model.model_args.pretrained_model_name_or_path=saves/models/sequential_round2 \
  task_name=sequential_round3 \
  trainer.args.num_train_epochs=${EPOCHS} \
  trainer.args.per_device_train_batch_size=${BATCH_SIZE} \
  trainer.args.gradient_accumulation_steps=${GRAD_ACCUM} \
  +trainer.args.save_strategy=epoch \
  trainer.args.output_dir=saves/models/sequential_round3

echo "--- Round 3: Evaluating ---"
$PYTHON src/eval.py --config-name=eval.yaml \
  experiment=eval/tofu/default \
  model=${MODEL} \
  model.model_args.pretrained_model_name_or_path=saves/models/sequential_round3 \
  retain_logs_path=saves/eval/tofu_${MODEL}_retain90/TOFU_EVAL.json \
  task_name=sequential_round3_eval


# ══════════════════════════════════════════════════════════════
# RELEARNING ATTACK: Try to relearn forget10 on the round3 model
# ══════════════════════════════════════════════════════════════
echo "--- Relearning attack on round3 model ---"

$PYTHON src/train.py --config-name=finetune.yaml \
  experiment=finetune/tofu/default \
  split=forget10 \
  model=${MODEL} \
  model.model_args.pretrained_model_name_or_path=saves/models/sequential_round3 \
  task_name=sequential_relearn \
  trainer.args.num_train_epochs=1 \
  trainer.args.per_device_train_batch_size=${BATCH_SIZE} \
  trainer.args.gradient_accumulation_steps=${GRAD_ACCUM} \
  +trainer.args.save_strategy=epoch \
  trainer.args.output_dir=saves/models/sequential_relearn

echo "--- Relearning attack: Evaluating ---"
$PYTHON src/eval.py --config-name=eval.yaml \
  experiment=eval/tofu/default \
  model=${MODEL} \
  model.model_args.pretrained_model_name_or_path=saves/models/sequential_relearn \
  retain_logs_path=saves/eval/tofu_${MODEL}_retain90/TOFU_EVAL.json \
  task_name=sequential_relearn_eval

echo "=============================="
echo "Pipeline complete!"
echo "Results in saves/eval/sequential_*"
echo "=============================="
